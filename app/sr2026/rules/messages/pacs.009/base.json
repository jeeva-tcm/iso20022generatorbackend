{
  "messageType": "pacs.009.001.08",
  "version": "SR2026",
  "standard": "ISO 20022 CBPR+",
  "businessService": "swift.cbprplus.04",
  "validationMode": "STRICT",

  "headerRules": [
    {
      "ruleId": "HDR001",
      "field": "AppHdr/BizSvc",
      "type": "ENUM",
      "allowedValues": [
        "swift.cbprplus.04",
        "swift.cbprplus.adv.04",
        "swift.cbprplus.cov.04"
      ],
      "severity": "ERROR",
      "errorCode": "PACS009_HDR_001",
      "errorMessage": "Invalid Business Service.",
      "fixSuggestion": "Set AppHdr/BizSvc to swift.cbprplus.04, swift.cbprplus.adv.04, or swift.cbprplus.cov.04."
    },
    {
      "ruleId": "HDR002",
      "field": "AppHdr/MsgDefIdr",
      "type": "FIXED_VALUE",
      "expected": "pacs.009.001.08",
      "severity": "ERROR",
      "errorCode": "PACS009_HDR_002",
      "errorMessage": "Invalid Message Definition Identifier.",
      "fixSuggestion": "Use pacs.009.001.08."
    },
    {
      "ruleId": "HDR003",
      "type": "FIELD_MATCH",
      "sourceField": "AppHdr/BizMsgIdr",
      "targetField": "GrpHdr/MsgId",
      "severity": "ERROR",
      "errorCode": "PACS009_HDR_003",
      "errorMessage": "BizMsgIdr must match MsgId."
    },
    {
      "ruleId": "HDR004",
      "type": "FIELD_MATCH",
      "sourceField": "AppHdr/Fr/FIId/FinInstnId/BICFI",
      "targetField": "Document/FICdtTrf/CdtTrfTxInf/InstgAgt/FinInstnId/BICFI",
      "severity": "ERROR",
      "errorCode": "PACS009_HDR_004",
      "errorMessage": "BAH From BIC must match InstgAgt BIC."
    },
    {
      "ruleId": "HDR005",
      "type": "FIELD_MATCH",
      "sourceField": "AppHdr/To/FIId/FinInstnId/BICFI",
      "targetField": "Document/FICdtTrf/CdtTrfTxInf/InstdAgt/FinInstnId/BICFI",
      "severity": "ERROR",
      "skipWhen": {
        "field": "AppHdr/CpyDplct",
        "values": ["COPY", "CODU"]
      },
      "errorCode": "PACS009_HDR_005",
      "errorMessage": "BAH To BIC must match InstdAgt BIC."
    },
    {
      "ruleId": "HDR006",
      "field": "AppHdr/CpyDplct",
      "type": "ENUM",
      "allowedValues": ["COPY", "CODU", "DUPL"],
      "severity": "ERROR",
      "errorCode": "PACS009_HDR_006",
      "errorMessage": "Invalid CopyDuplicate value."
    }
  ],

  "groupHeaderRules": [
    {
      "ruleId": "GRP001",
      "field": "GrpHdr/NbOfTxs",
      "type": "COUNT_MATCH",
      "countOf": "Document/FICdtTrf/CdtTrfTxInf",
      "expected": 1,
      "severity": "ERROR",
      "errorCode": "PACS009_GRP_001",
      "errorMessage": "Number of transactions must be exactly 1 and must match actual CdtTrfTxInf count."
    },
    {
      "ruleId": "GRP002",
      "field": "GrpHdr/SttlmInf/SttlmMtd",
      "type": "ENUM",
      "allowedValues": ["INDA", "INGA", "COVE"],
      "severity": "ERROR",
      "errorCode": "PACS009_GRP_002",
      "errorMessage": "Invalid settlement method."
    },
    {
      "ruleId": "GRP003",
      "field": "GrpHdr/CreDtTm",
      "type": "ISO_DATETIME",
      "severity": "ERROR",
      "errorCode": "PACS009_GRP_003",
      "errorMessage": "Invalid Group Header Creation DateTime."
    }
  ],

  "transactionRules": [
    {
      "ruleId": "TXN001",
      "field": "CdtTrfTxInf/PmtId/UETR",
      "type": "UUID_V4",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "mandatory": true,
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_001",
      "errorMessage": "Invalid UETR. Must be UUID version 4."
    },
    {
      "ruleId": "TXN002",
      "field": "CdtTrfTxInf/IntrBkSttlmDt",
      "type": "DATE",
      "format": "yyyy-MM-dd",
      "mandatory": true,
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_002",
      "errorMessage": "Invalid settlement date."
    },
    {
      "ruleId": "TXN003",
      "field": "CdtTrfTxInf/IntrBkSttlmAmt",
      "type": "AMOUNT",
      "mandatory": true,
      "maxDigits": 14,
      "fractionDigits": 5,
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_003",
      "errorMessage": "Invalid settlement amount."
    },
    {
      "ruleId": "TXN004",
      "field": "CdtTrfTxInf/IntrBkSttlmAmt",
      "type": "POSITIVE_AMOUNT",
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_004",
      "errorMessage": "Settlement amount must be greater than zero."
    },
    {
      "ruleId": "TXN005",
      "field": "CdtTrfTxInf/IntrBkSttlmAmt/@Ccy",
      "type": "ISO4217_CURRENCY",
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_005",
      "errorMessage": "Invalid ISO 4217 currency code."
    },
    {
      "ruleId": "TXN006",
      "field": "CdtTrfTxInf/IntrBkSttlmAmt",
      "type": "CURRENCY_DECIMAL_PRECISION",
      "severity": "ERROR",
      "errorCode": "PACS009_TXN_006",
      "errorMessage": "Invalid decimal precision for currency."
    }
  ],

  "addressRules": [
    {
      "ruleId": "ADR001",
      "field": "PstlAdr",
      "scope": [
        "Document/FICdtTrf/CdtTrfTxInf/Dbtr/PstlAdr",
        "Document/FICdtTrf/CdtTrfTxInf/Cdtr/PstlAdr",
        "Document/FICdtTrf/CdtTrfTxInf/IntrmyAgt1/FinInstnId/PstlAdr",
        "Document/FICdtTrf/CdtTrfTxInf/IntrmyAgt2/FinInstnId/PstlAdr"
      ],
      "type": "STRUCTURED_ADDRESS",
      "mandatoryFields": ["TwnNm", "Ctry"],
      "severity": "ERROR",
      "errorCode": "PACS009_ADR_001",
      "errorMessage": "Structured address is incomplete. TwnNm and Ctry are mandatory."
    }
  ],

  "bicRules": [
    {
      "ruleId": "BIC001",
      "field": "InstgAgt/FinInstnId/BICFI",
      "type": "BIC",
      "mandatory": true,
      "liveBicValidation": false,
      "severity": "ERROR",
      "errorCode": "PACS009_BIC_001",
      "errorMessage": "Invalid instructing agent BIC."
    },
    {
      "ruleId": "BIC002",
      "field": "InstdAgt/FinInstnId/BICFI",
      "type": "BIC",
      "mandatory": true,
      "liveBicValidation": false,
      "severity": "ERROR",
      "errorCode": "PACS009_BIC_002",
      "errorMessage": "Invalid instructed agent BIC."
    }
  ],

  "leiRules": [
    {
      "ruleId": "LEI001",
      "field": "*/FinInstnId/LEI",
      "type": "REGEX",
      "pattern": "^[A-Z0-9]{20}$",
      "checksum": "ISO17442",
      "severity": "ERROR",
      "errorCode": "PACS009_LEI_001",
      "errorMessage": "Invalid LEI format. Must be 20 uppercase alphanumeric characters with a valid ISO 17442 checksum."
    }
  ],

  "cbprPlusRules": [
    {
      "ruleId": "CBPR001",
      "type": "SUPPLEMENTARY_DATA_NOT_ALLOWED",
      "severity": "ERROR",
      "errorCode": "PACS009_CBPR_001",
      "errorMessage": "SupplementaryData is not allowed in CBPR+."
    },
    {
      "ruleId": "CBPR002",
      "field": "PmtTpInf/SvcLvl/Cd",
      "type": "FIXED_VALUE",
      "expected": "G004",
      "configurable": true,
      "configNote": "Verify against your SR2026 CBPR+ business specification. Set configurable=false to enforce strictly, or replace with ENUM type if multiple service level codes are permitted in your flow.",
      "severity": "ERROR",
      "errorCode": "PACS009_CBPR_002",
      "errorMessage": "Invalid GPI Service Level Code. Expected G004."
    }
  ],

  "formatRules": [
    {
      "ruleId": "FMT001",
      "type": "FIN_X_CHARACTER_SET",
      "scope": [
        "AppHdr/BizMsgIdr",
        "Document/FICdtTrf/GrpHdr/MsgId",
        "Document/FICdtTrf/CdtTrfTxInf/PmtId/InstrId",
        "Document/FICdtTrf/CdtTrfTxInf/PmtId/EndToEndId",
        "Document/FICdtTrf/CdtTrfTxInf/PmtId/TxId",
        "Document/FICdtTrf/CdtTrfTxInf/RmtInf/Ustrd",
        "Document/FICdtTrf/CdtTrfTxInf/InstrForNxtAgt/InstrInf",
        "Document/FICdtTrf/CdtTrfTxInf/InstrForCdtrAgt/InstrInf",
        "Document/FICdtTrf/CdtTrfTxInf/Purp/Prtry"
      ],
      "severity": "ERROR",
      "errorCode": "PACS009_FMT_001",
      "errorMessage": "Invalid FIN-X character detected in free-text field."
    }
  ],

  "duplicateRules": [
    {
      "ruleId": "DUP001",
      "field": "UETR",
      "type": "HISTORICAL_DUPLICATE_CHECK",
      "lookbackWindow": "PT24H",
      "severity": "WARNING",
      "errorCode": "PACS009_DUP_001",
      "errorMessage": "Possible duplicate — UETR has been seen within the lookback window."
    },
    {
      "ruleId": "DUP002",
      "field": "MsgId",
      "type": "HISTORICAL_DUPLICATE_CHECK",
      "lookbackWindow": "PT24H",
      "severity": "WARNING",
      "errorCode": "PACS009_DUP_002",
      "errorMessage": "Possible duplicate — MsgId has been seen within the lookback window."
    },
    {
      "ruleId": "DUP003",
      "field": "BizMsgIdr",
      "type": "HISTORICAL_DUPLICATE_CHECK",
      "lookbackWindow": "PT24H",
      "severity": "WARNING",
      "errorCode": "PACS009_DUP_003",
      "errorMessage": "Possible duplicate — BizMsgIdr has been seen within the lookback window."
    }
  ],

  "validationOrder": [
    "XSD",
    "HEADER",
    "GROUP_HEADER",
    "TRANSACTION",
    "ADDRESS",
    "BIC",
    "LEI",
    "CBPR",
    "FORMAT",
    "DUPLICATE"
  ]
}
