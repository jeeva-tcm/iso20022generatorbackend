  "business_rules": [
    {
      "id": "R1",
      "name": "CBPR_To_Receiver_Agent_BIC_1_FormalRule",
      "kind": "FormalRule",
      "description": "BAH \"To\" BIC must match \"Receiver\" BIC, except where BAH CopyDuplicate = COPY or = CODU",
      "formal_definition": "For each [Full Message], if every occurrence of [FullMessage/BusinessApplicationHeaderV02/CopyDuplicate] has value not included in the following list 'COPY' or 'CODU' , then every occurrence of [FullMessage/BusinessApplicationHeaderV02/To/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI] must have the same value than every occurrence of [FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Receiver/Agent/FinancialInstitutionIdentification/BICFI]",
      "referenced_paths": [
        "[FullMessage/BusinessApplicationHeaderV02/CopyDuplicate]",
        "[FullMessage/BusinessApplicationHeaderV02/To/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI]",
        "[FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Receiver/Agent/FinancialInstitutionIdentification/BICFI]"
      ]
    },
    {
      "id": "R2",
      "name": "CBPR_To_Receiver_Agent_BIC_2_FormalRule",
      "kind": "FormalRule",
      "description": "BAH \"To\" BIC must match \"Receiver\" BIC if CopyDuplicate is absent",
      "formal_definition": "For each [Full Message], if the following element(s) [FullMessage/BusinessApplicationHeaderV02/CopyDuplicate] is (are) absent , then every occurrence of [FullMessage/BusinessApplicationHeaderV02/To/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI] must have the same value than every occurrence of [FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Receiver/Agent/FinancialInstitutionIdentification/BICFI]",
      "referenced_paths": [
        "[FullMessage/BusinessApplicationHeaderV02/CopyDuplicate]",
        "[FullMessage/BusinessApplicationHeaderV02/To/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI]",
        "[FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Receiver/Agent/FinancialInstitutionIdentification/BICFI]"
      ]
    },
    {
      "id": "R3",
      "name": "CBPR_BusinessMessageIdentifier_FormalRule",
      "kind": "FormalRule",
      "description": "The Business Message Identifier must match the Message Identification in the Group Header.",
      "formal_definition": "For each [Full Message], every occurrence of [FullMessage/BusinessApplicationHeaderV02/BusinessMessageIdentifier] value must be equal to every occurrence of [FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/MessageIdentification] value",
      "referenced_paths": [
        "[FullMessage/BusinessApplicationHeaderV02/BusinessMessageIdentifier]",
        "[FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/MessageIdentification]"
      ]
    },
    {
      "id": "R4",
      "name": "CBPR_From_Sender_Agent_BIC_FormalRule",
      "kind": "FormalRule",
      "description": "BAH \"From\" BIC must match \"Sender\" BIC",
      "formal_definition": "For each [Full Message], every occurrence of [FullMessage/BusinessApplicationHeaderV02/From/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI] value must be equal to every occurrence of [FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Sender/Agent/FinancialInstitutionIdentification/BICFI] value",
      "referenced_paths": [
        "[FullMessage/BusinessApplicationHeaderV02/From/FinancialInstitutionIdentification/FinancialInstitutionIdentification/BICFI]",
        "[FullMessage/Document/NotificationOfCorrespondenceV01/GroupHeader/Sender/Agent/FinancialInstitutionIdentification/BICFI]"
      ]
    },
    {
      "id": "R5",
      "name": "CBPR_Related_Business_Application_Header_TextualRule",
      "kind": "TextualRule",
      "description": "If used, the Related BAH must transport the exact same information as in the BAH of the related message.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R6",
      "name": "CBPR_Business_Message_Identifier_TextualRule",
      "kind": "TextualRule",
      "description": "The Business Message Identifier is the unique identifier of the Business Message instance that is being transported with this header, as defined by the sending application or system. Must contain the Message Identification element from the Group Header of the underlying message, where available (as is typically the case with pacs, pain, and camt messages, for example). If Message Identification is not available in the underlying message, then this element must contain the unique identifier of the Business Message instance.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R7",
      "name": "CBPR_Message_Definition_Identifier_TextualRule",
      "kind": "TextualRule",
      "description": "The Message Definition Identifier of the Business Message instance that is being transported with this header. In general, it must be formatted exactly as it appears in the namespace of the Business Message instance.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R8",
      "name": "CBPR_Related_BAH_Business_Service_TextualRule",
      "kind": "TextualRule",
      "description": "If related BAH is present, it should transport the element Business Service.",
      "formal_definition": null,
      "referenced_paths": []
    }
  ]
