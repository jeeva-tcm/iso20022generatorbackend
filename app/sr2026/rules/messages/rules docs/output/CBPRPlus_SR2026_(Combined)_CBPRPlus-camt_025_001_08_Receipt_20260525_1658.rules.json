  "business_rules": [
    {
      "id": "R1",
      "name": "CBPR_BusinessMessageIdentifier_FormalRule",
      "kind": "FormalRule",
      "description": "The Business Message Identifier must match the Message Identification in the Message Header.",
      "formal_definition": "For each [Full Message], every occurrence of [FullMessage/BusinessApplicationHeaderV02/BusinessMessageIdentifier] value must be equal to every occurrence of [FullMessage/Document/ReceiptV08/MessageHeader/MessageIdentification] value",
      "referenced_paths": [
        "[FullMessage/BusinessApplicationHeaderV02/BusinessMessageIdentifier]",
        "[FullMessage/Document/ReceiptV08/MessageHeader/MessageIdentification]"
      ]
    },
    {
      "id": "R2",
      "name": "CBPR_Related_Business_Application_Header_TextualRule",
      "kind": "TextualRule",
      "description": "If used, the Related BAH must transport the exact same information as in the BAH of the related message.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R3",
      "name": "CBPR_Business_Message_Identifier_TextualRule",
      "kind": "TextualRule",
      "description": "The Business Message Identifier is the unique identifier of the Business Message instance that is being transported with this header, as defined by the sending application or system. Must contain the Message Identification element from the Group Header of the underlying message, where available (as is typically the case with pacs, pain, and camt messages, for example). If Message Identification is not available in the underlying message, then this field must contain the unique identifier of the Business Message instance.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R4",
      "name": "CBPR_Message_Definition_Identifier_TextualRule",
      "kind": "TextualRule",
      "description": "The Message Definition Identifier of the Business Message instance that is being transported with this header. In general, it must be formatted exactly as it appears in the namespace of the Business Message instance.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R5",
      "name": "CBPR_Related_BAH_Business_Service_TextualRule",
      "kind": "TextualRule",
      "description": "If related BAH is present, it should transport the element Business Service.",
      "formal_definition": null,
      "referenced_paths": []
    },
    {
      "id": "R6",
      "name": "CBPR_Message_Name_Identification_FormalRule",
      "kind": "FormalRule",
      "description": "This element must be populated with either camt.106.001.xx, camt.057.001.xx or camt.058.001.xx",
      "formal_definition": "For each [FullMessage/Document/ReceiptV08/ReceiptDetails/OriginalMessageIdentification/MessageNameIdentification], the value of every occurrence of [MessageNameIdentification] must comply with the following XML pattern : 'camt\\.106\\.001\\.[0-9]{2}|camt\\.05[78]\\.001\\.[0-9]{2}'",
      "referenced_paths": [
        "[FullMessage/Document/ReceiptV08/ReceiptDetails/OriginalMessageIdentification/MessageNameIdentification]"
      ]
    },
    {
      "id": "R7",
      "name": "CBPR_Request_Handling_Status_Reject_Reason_FormalRule",
      "kind": "FormalRule",
      "description": "If the Request Handling Status is RJCT, then a Status Reason must be provided",
      "formal_definition": "For each [FullMessage/Document/ReceiptV08/ReceiptDetails/RequestHandling], if every occurrence of [RequestHandling/Status/Code] has value included in the following list 'RJCT' , then at least one occurrence of the following element(s) [RequestHandling/StatusReason/Reason] must be present",
      "referenced_paths": [
        "[FullMessage/Document/ReceiptV08/ReceiptDetails/RequestHandling]",
        "[RequestHandling/Status/Code]",
        "[RequestHandling/StatusReason/Reason]"
      ]
    }
  ]
}